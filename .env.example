NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public URL of the deployed site, used for link previews (optional on Vercel)
NEXT_PUBLIC_SITE_URL=https://aaryann.dev

# Server-only. Lets /api/contact save messages to the inbox. Never expose this key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: also email each contact message to you (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@example.com
